# 服务端口
PORT=6688

# 允许的域名
ALLOWED_DOMAIN="*"

# 允许的主域名（填写则忽略 ALLOWED_DOMAIN）
ALLOWED_HOST=""

# Redis 配置（可留空使用内存缓存）
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# 缓存时长（秒）
CACHE_TTL=3600

# 请求超时（毫秒）
REQUEST_TIMEOUT=6000

# 是否输出日志
USE_LOG_FILE=true

# RSS Mode
RSS_MODE=false

# 微博过滤广告
FILTER_WEIBO_ADVERTISEMENT=false
